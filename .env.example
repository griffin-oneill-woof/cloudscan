# Copy this file to .env and fill in what you need. Everything below has a working default —
# CloudScan runs with none of these set.

# --- Company-name resolution / enrichment -----------------------------------------------------
# Lets CloudScan resolve a company name (not just a domain/URL) via the Apollo API, and is required
# for the optional Apollo enrichment pass below. Without it, name resolution falls back to guessing
# slug+TLD and verifying by DNS + homepage <title>.
APOLLO_API_KEY=
# Set to 1 to also pull Apollo firmographic data (employee count, country) into the report.
# Costs Apollo credits — opt-in on purpose, separate from just setting APOLLO_API_KEY above.
CLOUDSCAN_APOLLO_ENRICH=
# Raises the GitHub API rate limit and enables the code-search pass in the github collector.
GITHUB_TOKEN=

# --- Cache -------------------------------------------------------------------------------------
CLOUDSCAN_CACHE_DIR=~/.cache/cloudscan
CLOUDSCAN_DB=~/.cache/cloudscan/reports.sqlite
CLOUDSCAN_CACHE_TTL=604800

# --- Network -----------------------------------------------------------------------------------
CLOUDSCAN_NAMESERVERS=
CLOUDSCAN_DNS_TIMEOUT=3
CLOUDSCAN_HTTP_TIMEOUT=8
CLOUDSCAN_USER_AGENT=cloudscan/1.0 (+public infrastructure research)

# --- Azure IP ranges ------------------------------------------------------------------------
# Works out of the box: CloudScan finds this week's Service Tags JSON on Microsoft's download
# page automatically. Set one of these only to pin a specific URL/mirror or use a local copy
# (e.g. if outbound access to microsoft.com is blocked).
CLOUDSCAN_AZURE_RANGES_URL=
CLOUDSCAN_AZURE_RANGES_FILE=

# --- API server ---------------------------------------------------------------------------------
# Not set by default (the server warns on startup when it's missing). Set this before deploying
# anywhere but your own machine — it requires the X-Api-Key header (or ?key=) on every endpoint
# except / and /api/health.
CLOUDSCAN_API_KEY=
# Comma-separated allowed origins for cross-origin browser JS. Empty (default) = closed; the
# bundled web UI is same-origin and doesn't need this at all. Only set it if a separate frontend
# calls this API directly from the browser.
CLOUDSCAN_CORS=
CLOUDSCAN_BATCH_CONCURRENCY=4

# --- ICP / lead scoring --------------------------------------------------------------------------
CLOUDSCAN_ICP_MIN_EMPLOYEES=50
CLOUDSCAN_ICP_MAX_EMPLOYEES=500
CLOUDSCAN_ICP_COUNTRIES=United States,Canada
